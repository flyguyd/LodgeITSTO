# The STO portal server — copy to .env next to server.mjs (or use the systemd
# EnvironmentFile). Node built-ins only; nothing to install.

# Where it listens. Put nginx / Caddy in front for TLS; the server trusts
# X-Forwarded-For from that proxy (TRUSTED_PROXY=0 to ignore it).
PORT=3300
LISTEN_HOST=127.0.0.1
TRUSTED_PROXY=1

# The built Angular app (`cd app && npm run build` → app/dist/sto-portal/browser).
DIST_DIR=/opt/lodgeit-sto-portal/browser

# Lodge Ops: the portal signs EVERY call with this key and secret (HMAC, like
# the booking-engine link). Key id and secret come from Lodge Ops → Settings →
# STO Portal; the secret is shown ONCE when created or rotated.
LODGEOPS_URL=https://lodgeops.example.com/api
STO_KEY=sto-portal
STO_SECRET=

# Everything else — which engine to ask, the engine client the portal signs as,
# its rate limit, session hours, its public address — is set on Lodge Ops →
# Settings → STO Portal and pulled over the signed link on boot and every
# minute (CONFIG_PULL_MS, default 60000). Nothing more goes in this file.
