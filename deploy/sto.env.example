# The STO portal server — copy to .env next to server.mjs (or use the systemd
# EnvironmentFile). Node built-ins only; nothing to install.

# Where it listens. Put nginx / Caddy in front for TLS; the server trusts
# X-Forwarded-For from that proxy (TRUSTED_PROXY=0 to ignore it).
PORT=3300
LISTEN_HOST=127.0.0.1
TRUSTED_PROXY=1

# The built Angular app (`cd app && npm run build` → app/dist/sto-portal/browser).
DIST_DIR=/opt/lodgeit-sto-portal/browser

# Lodge Ops: the portal signs EVERY call with this key and secret (HMAC, like
# the booking-engine link). Key id and secret come from Lodge Ops → STO →
# "The STO portal" card; the secret is shown ONCE when rotated.
LODGEOPS_URL=https://lodgeops.example.com/api
STO_KEY=sto-portal
STO_SECRET=

# The Booking Engine: the portal is its own registered client (availability,
# quotes, the calendar). Register it on the engine as key `sto`.
ENGINE_URL=https://ratebox.example.com
CLIENT_KEY=sto
CLIENT_SECRET=

# Requests per client IP per window before 429 (defaults 240 / 60 s).
RATE_LIMIT=240
RATE_WINDOW_MS=60000
